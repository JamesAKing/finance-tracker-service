# Copy this file to .env and set your own values.

# Port the service listens on
PORT=3000

# Postgres connection string used by the service and drizzle-kit.
# Host port 5434 maps to the container's 5432 (see docker-compose.yml).
# The user, password and database name must match the POSTGRES_* values below.
DATABASE_URL=postgres://postgres:password@localhost:5434/finance_tracker

# Used by docker compose to create the database on first start
POSTGRES_DB=finance_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Origin the browser uses (the Vite dev server). Must match WEB_ORIGIN in identity/.env
WEB_ORIGIN=http://localhost:5173

# Keycloak (see the identity repo)
OIDC_ISSUER_URL=http://localhost:8080/realms/finance-tracker
OIDC_CLIENT_ID=finance-tracker-api
# Must match API_CLIENT_SECRET in identity/.env
OIDC_CLIENT_SECRET=<same value as API_CLIENT_SECRET>

# Optional. Where the service itself reaches Keycloak, when that differs from the issuer
# (e.g. inside Docker). Set by docker-compose.yml; leave unset for npm run dev.
# OIDC_INTERNAL_URL=http://keycloak:8080

# Optional. Session timeouts in seconds; keep in step with ssoSessionIdleTimeout /
# ssoSessionMaxLifespan in identity/keycloak/realm.json
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_MAX_LIFESPAN_SECONDS=36000
