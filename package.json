{
  "name": "finance-tracker-service",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:api": "redocly lint openapi.yaml",
    "generate:client": "openapi-generator-cli generate -i openapi.yaml -g typescript-fetch --global-property apiDocs=false,modelDocs=false --additional-properties=withoutRuntimeChecks=true -o",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test",
    "test:integration": "node --test --env-file-if-exists=.env \"src/**/*.integration.ts\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "docker compose run --rm liquibase && drizzle-kit pull && node scripts/fix-generated-schema.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@redocly/cli": "^2.72.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxfmt",
      "oxlint"
    ],
    "*.{json,md}": [
      "oxfmt"
    ]
  },
  "engines-strict": {
    "node": ">=24"
  }
}
